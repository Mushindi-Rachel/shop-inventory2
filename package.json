{
    "name": "shop-inventory",
    "version": "1.0.0",
    "private": true,
    "main": "electron/main.js",
    "scripts": {
        "dev": "next dev -H 0.0.0.0",
        "build": "next build",
        "start": "next start -H 0.0.0.0",
        "electron": "electron .",
        "dist": "next build && electron-builder"
    },
    "dependencies": {
        "better-sqlite3": "11.1.2",
        "drizzle-orm": "^0.45.2",
        "next": "^16.2.10",
        "qrcode": "1.5.3",
        "react": "18.3.1",
        "react-dom": "18.3.1",
        "recharts": "2.12.7",
        "uuid": "^14.0.1"
    },
    "devDependencies": {
        "@types/better-sqlite3": "7.6.11",
        "@types/node": "20.14.10",
        "@types/qrcode": "1.5.5",
        "@types/react": "18.3.3",
        "@types/react-dom": "18.3.0",
        "@types/uuid": "9.0.8",
        "autoprefixer": "10.4.19",
        "electron": "^30.0.9",
        "electron-builder": "^26.15.3",
        "electron-rebuild": "^3.2.9",
        "postcss": "8.4.39",
        "tailwindcss": "3.4.4",
        "typescript": "5.5.3"
    },
    "build": {
        "appId": "com.mushindirachel.shopinventory",
        "productName": "Shop Inventory",
        "directories": {
            "output": "dist"
        },
        "files": [
            ".next/**/*",
            "electron/**/*",
            "node_modules/**/*",
            "public/**/*",
            "src/**/*",
            "package.json",
            "next.config.js"
        ],
        "asar": true,
        "win": {
            "target": "nsis",
            "icon": "electron/icon.ico"
        },
        "nsis": {
            "oneClick": false,
            "allowToChangeInstallationDirectory": true
        }
    }
}